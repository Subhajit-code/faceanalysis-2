# Postgres connection string — get this from Neon (neon.tech) or Supabase's
# free tier, not a local file. e.g. "postgresql://user:pass@host/dbname?sslmode=require"
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
FACE_ENGINE_URL="http://localhost:8000"
# Shared secret so only this API can call the face-engine. Required in any
# hosted deployment (e.g. Render) where the face-engine gets its own public
# URL; leave blank for local dev since localhost:8000 isn't internet-reachable.
FACE_ENGINE_INTERNAL_TOKEN=""
AES_KEY="replace-with-32-byte-hex-key-for-embedding-encryption"
PORT=4000
ALLOWED_ORIGIN="http://localhost:5173"
# Minimum ArcFace cosine similarity (0-1, higher = stricter) to accept a face match.
MATCH_THRESHOLD="0.45"
LIVENESS_MIN_SCORE="0.2"
NODE_ENV="production"
